<Project>

  <!--
    Single source of truth for the Revit version this add-in targets.
    To move to Revit 2028 later: change RevitVersion here, confirm RevitApiDir
    resolves, and re-check TargetFramework against that release's runtimeconfig.json.
  -->
  <PropertyGroup>
    <RevitVersion>2027</RevitVersion>
    <RevitApiDir>$(ProgramW6432)\Autodesk\Revit $(RevitVersion)</RevitApiDir>

    <!--
      ALL-USERS, NOT PER-USER (changed 2026-09-08). This used to be %AppData% - correct
      while DKSI Revit Tools was a per-user install, wrong the moment the office switched to
      one shared machine-wide copy in Program Files. Left pointed at %AppData%, an ordinary
      `dotnet build` - from an IDE, from a colleague, from anyone, for any reason - silently
      recreated a second manifest for the same add-in, and Revit loads one of the two with no
      way to tell which. That happened for real: a suite deploy correctly went to Program
      Files, and a plain build run separately (an IDE's build-on-save, most likely - nothing
      in that session's own command history touched this project) put a Debug DLL back in
      %AppData% within the hour, undoing a per-user removal that had been done on purpose.
      See tools\Remove-PerUserInstall.ps1 for why the two manifests cannot coexist.

      THE COST, ACCEPTED ON PURPOSE: an ordinary unelevated `dotnet build` can no longer
      deploy at all - Program Files needs admin rights. DeployToRevitAddins is WarnAndContinue
      either way, so the build itself still succeeds; VerifyRevitDeploy's warning below now
      names both possible causes rather than assuming the old one.
    -->
    <RevitAddinsDir>$(ProgramFiles)\Autodesk\Revit\Addins\$(RevitVersion)</RevitAddinsDir>
  </PropertyGroup>

  <!--
    Revit 2027 runs on .NET 10 (verified: RevitAPI.runtimeconfig.json reports
    "tfm": "net10.0"). An add-in must target the same major runtime as the host.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <Company>DKSI</Company>
    <Product>DKSI Revit Tools</Product>
    <Version>1.0.0</Version>
    <Copyright>Copyright © $(Company) 2026</Copyright>
  </PropertyGroup>

  <!--
    Stamp the targeted Revit version INTO the assembly, so the running add-in can check the
    host it was actually loaded into and refuse anything else. Sourced from the same
    RevitVersion property as the API references and the deploy path, so a build for one
    version cannot carry a guard for another - see BuildInfo.TargetRevitVersion.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>RevitVersion</_Parameter1>
      <_Parameter2>$(RevitVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Which projects actually reference RevitAPI.dll. True for everything by default, because
    the add-in is what this repository is for and a missing Revit install should be a loud
    failure there.

    The test projects set it false. They deliberately reference no Revit assembly - each
    compiles a handful of plain-arithmetic source files out of the add-in - which is what
    lets them run on a build machine or in CI, and the guard below was the one thing
    stopping them: it is imported by every project under this folder, so a machine with no
    Revit failed the tests before compiling a line of them.
  -->
  <PropertyGroup>
    <RequiresRevitApi Condition="'$(RequiresRevitApi)' == ''">true</RequiresRevitApi>
  </PropertyGroup>

  <!--
    Is there a real Revit install to build against?

    Yes on any developer machine and on the office's machines, and that path is unchanged:
    the add-in references RevitAPI.dll and RevitAPIUI.dll straight out of the install.

    No on a CI runner, which cannot have licensed desktop software on it. Rather than
    leaving the add-in as the one project nothing ever compiles before merge, it falls back
    to the Nice3point reference assemblies from NuGet - see the long comment in
    Cda.Revit.Addin.csproj for why they are referenced with ExcludeAssets="runtime", which
    is load-bearing rather than decorative.
  -->
  <PropertyGroup>
    <HasLocalRevitApi Condition="Exists('$(RevitApiDir)\RevitAPI.dll')">true</HasLocalRevitApi>
    <HasLocalRevitApi Condition="'$(HasLocalRevitApi)' == ''">false</HasLocalRevitApi>

    <!--
      Pinned to the Revit the office actually runs - 27.1.0.45, so the 2027.1 package.
      Keep it at or BELOW the installed build, never above: the Revit API is additive, so
      an older reference assembly can only compile calls the installed Revit also has,
      while a newer one lets CI go green on a method that is missing at runtime.
    -->
    <RevitApiPackageVersion>2027.1.0</RevitApiPackageVersion>
  </PropertyGroup>

  <!--
    A build with no local Revit still compiles, but it can neither deploy nor prove
    anything about the installed Revit, so it says so once rather than looking normal.

    This used to be an Error. It stopped hundreds of "type not found" messages, which the
    NuGet fallback now prevents outright - but it also caught a misconfigured RevitApiDir,
    and that job still matters: a developer who thinks they are deploying and is silently
    building against reference assemblies has a worse problem than a failed build. Hence
    the warning, and hence deploying is switched off below rather than copying a DLL built
    against assemblies that may not match the Revit on this machine.
  -->
  <Target Name="VerifyRevitApiDir" BeforeTargets="BeforeBuild"
          Condition="'$(RequiresRevitApi)' == 'true' AND '$(HasLocalRevitApi)' != 'true'">
    <Warning Text="No Revit $(RevitVersion) install at '$(RevitApiDir)' - building against NuGet reference assemblies $(RevitApiPackageVersion) instead. This compiles, but it CANNOT be deployed or debugged, and it does not prove the add-in runs on the installed Revit. If you do have Revit $(RevitVersion) here, RevitApiDir is pointing at the wrong folder - fix it in Directory.Build.props." />
  </Target>

  <!--
    No Revit means nothing to deploy to. Left on, the copy would either fail or, worse,
    put a DLL built against reference assemblies into a Revit install this build could not
    see well enough to reference.
  -->
  <PropertyGroup Condition="'$(HasLocalRevitApi)' != 'true'">
    <DeployToRevit>false</DeployToRevit>
  </PropertyGroup>

  <!--
    SINGLE VERSION ONLY. Multi-targeting this add-in would be a mistake rather than a
    feature: the Revit API is not binary compatible across releases, the host runtime
    changes with it (2026 is .NET 8, 2027 is .NET 10), and one assembly cannot satisfy both.
    This fails the build if someone adds a TargetFrameworks list, rather than letting a
    second, untested target ship quietly.
  -->
  <Target Name="ForbidMultiTargeting" BeforeTargets="BeforeBuild" Condition="'$(TargetFrameworks)' != ''">
    <Error Text="This add-in targets exactly one Revit release ($(RevitVersion), $(TargetFramework)). Remove TargetFrameworks - see the note in Directory.Build.props." />
  </Target>

</Project>
