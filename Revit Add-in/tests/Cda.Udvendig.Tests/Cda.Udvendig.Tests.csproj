<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NO REVIT REFERENCE, DELIBERATELY - same reason as Cda.Dimensions.Tests and
    Cda.Heating.Tests.

    RevitAPI.dll is a managed wrapper over native code that will not load outside the Revit
    host, so a test project referencing it can compile and still be unrunnable. This project
    compiles ONE source file from the add-in: UdvendigClassification.cs, which holds every
    decision behind the exterior/interior split and mentions no Revit type.

    Testing the real file rather than a copy is what makes these worth anything. A copied rule
    drifts from the shipping one and then passes forever.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cda.Udvendig.Tests</RootNamespace>
    <AssemblyName>Cda.Udvendig.Tests</AssemblyName>

    <UseWPF>false</UseWPF>
    <DeployToRevit>false</DeployToRevit>

    <!-- No Revit reference, so do not demand a Revit install to build. This is what makes
         "runs anywhere" above true rather than aspirational. -->
    <RequiresRevitApi>false</RequiresRevitApi>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Cda.Revit.Addin\Doors\UdvendigClassification.cs"
             Link="UdvendigClassification.cs" />
  </ItemGroup>

</Project>
