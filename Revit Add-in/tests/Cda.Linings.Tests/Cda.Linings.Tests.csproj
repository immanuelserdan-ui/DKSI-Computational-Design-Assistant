<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NO REVIT REFERENCE, DELIBERATELY - same reason as the other test projects. This compiles
    the shipping LiningSync.cs, which holds every decision behind the two-way door/window
    Lining YN and material sync and mentions no Revit type.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cda.Linings.Tests</RootNamespace>
    <AssemblyName>Cda.Linings.Tests</AssemblyName>

    <UseWPF>false</UseWPF>
    <DeployToRevit>false</DeployToRevit>
    <RequiresRevitApi>false</RequiresRevitApi>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Cda.Revit.Addin\Linings\LiningSync.cs" Link="LiningSync.cs" />
  </ItemGroup>

</Project>
