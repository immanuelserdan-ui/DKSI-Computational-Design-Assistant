<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NO REVIT REFERENCE, DELIBERATELY.

    The point of this project is that it runs while Revit is open, on a build machine, in CI -
    anywhere. RevitAPI.dll is a managed wrapper over native code that will not load outside the
    Revit host, so a test project that references it can compile and still be unrunnable.

    So it compiles ONE source file from the add-in: Seating.cs, which is deliberately written
    in plain arithmetic with no Revit type in it. That file holds every sign convention in the
    radiator tool, and every bug this tool has shipped has been a sign convention. Testing the
    real file rather than a copy is what makes these tests worth anything - a copied constant
    drifts from the shipping one and then passes forever.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cda.Heating.Tests</RootNamespace>
    <AssemblyName>Cda.Heating.Tests</AssemblyName>

    <!-- Directory.Build.props above targets net10.0-windows for the add-in; this is a plain
         console runner and has no need of the Windows desktop framework. -->
    <UseWPF>false</UseWPF>
    <DeployToRevit>false</DeployToRevit>

    <!-- No Revit reference, so do not demand a Revit install to build. This is what makes
         "runs anywhere" above true rather than aspirational. -->
    <RequiresRevitApi>false</RequiresRevitApi>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Cda.Revit.Addin\Heating\Seating.cs" Link="Seating.cs" />
  </ItemGroup>

</Project>
