<Window x:Class="Cda.Revit.Addin.UI.RoomPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report this paint under which room?"
        Height="560"
        Width="520"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F3F3F3"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="ItemBox" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="CurrentBox" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#444" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Foreground="#7A4A00"
                   Text="This changes only the room the row is REPORTED under. The area is not moved and not recounted, and the old room's own finish parameters keep the geometric figure — so that room's total and this row will disagree by this amount. Both rooms are recorded." />

        <TextBox Grid.Row="2"
                 x:Name="FilterBox"
                 Padding="5"
                 Margin="0,0,0,8"
                 ToolTip="Filter by room number, name or level" />

        <ListBox Grid.Row="3"
                 x:Name="RoomList"
                 SelectionMode="Single"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Width="60" />
                        <TextBlock Text="{Binding Name}" Width="240" />
                        <TextBlock Text="{Binding Level}" Foreground="#666" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="4" Text="Why (recorded with the override)" FontWeight="SemiBold" Margin="0,12,0,4" />
        <TextBox Grid.Row="5" x:Name="ReasonBox" Padding="5" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="Reassign" Width="110" Height="28" IsDefault="True" />
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="28" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
