<Window x:Class="Cda.Revit.Addin.UI.DiagnoseParamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnose Parameters"
        SizeToContent="Height"
        Width="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">

    <StackPanel Margin="16">

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
            Dumps every parameter Revit exposes on one material, one element type, and one
            placed instance of that type. Read-only — nothing is written to the model.
            Partial names are fine.
        </TextBlock>

        <TextBlock Text="Material name" FontWeight="SemiBold" />
        <TextBox x:Name="MaterialBox" Margin="0,4,0,12" Padding="4" />

        <TextBlock Text="Type name" FontWeight="SemiBold" />
        <TextBox x:Name="TypeBox" Margin="0,4,0,12" Padding="4" />

        <TextBlock x:Name="SelectionHint"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Opacity="0.75"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Run" IsDefault="True" Width="90" Height="26" Click="OnRun" />
            <Button Content="Cancel" IsCancel="True" Width="90" Height="26" Margin="8,0,0,0" />
        </StackPanel>

    </StackPanel>
</Window>
