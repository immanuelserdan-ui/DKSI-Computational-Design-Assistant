<Window x:Class="Cda.Revit.Addin.UI.RoomFinishCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finish Calculations — Checking"
        Width="620"
        Height="560"
        MinWidth="520"
        MinHeight="460"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" Opacity="0.85">
            Select a room, then Highlight. The walls, floor and ceiling its finish areas were
            measured from are selected in the model. Read-only unless you tick Isolate, which
            changes only the view's temporary visibility — never the model.
        </TextBlock>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Room" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Refresh list" Width="100" Height="24" Click="OnRefresh" />
            </Grid>
            <ComboBox x:Name="RoomBox" Margin="0,6,0,0" Height="26" SelectionChanged="OnRoomChanged" />
        </StackPanel>

        <!-- What the finish engine already wrote for this room. The point of the check:
             a number here plus the highlight below tells you where it came from. -->
        <Border Grid.Row="2"
                BorderBrush="#FF2576B2"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Finish areas written to this room" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ItemsControl x:Name="FinishList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Opacity="0.8" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" x:Name="CountsLine" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="NotesLine" TextWrapping="Wrap" Opacity="0.8" />
        </ScrollViewer>

        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <CheckBox x:Name="IsolateBox"
                      Content="Isolate the highlighted elements in the active view"
                      Margin="0,0,0,4" />
            <TextBlock Margin="20,0,0,8" Opacity="0.7" TextWrapping="Wrap"
                       Text="Temporary isolation only — cleared by Reset below, or by Revit's own Reset Temporary Hide/Isolate. The saved view is untouched." />
            <CheckBox x:Name="SweepBox"
                      Content="Include the skirting boards standing in this room"
                      Margin="0,0,0,4" />

            <CheckBox x:Name="ContentsBox"
                      Content="Include doors, windows, casework and MEP"
                      IsChecked="True"
                      Margin="0,0,0,4" />
            <TextBlock Margin="20,0,0,8" Opacity="0.7" TextWrapping="Wrap"
                       Text="Isolating only the boundary leaves a box of bare walls with holes in it. The doors, windows and fittings are what make the isolated view navigable — they add nothing to the finish areas." />

            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="SectionBoxBox"
                          Content="Section box around the room, offset"
                          IsChecked="True"
                          VerticalAlignment="Center" />
                <TextBox x:Name="OffsetBox" Text="1000" Width="56" Padding="3" Margin="8,0,0,0" />
                <TextBlock Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock Margin="20,2,0,0" Opacity="0.7" TextWrapping="Wrap"
                       Text="A wall is ONE element, so isolating it shows its whole length — including the part that runs into the next room. Cutting the view is the only way to hide that. In a non-3D view a crop region is used instead." />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Clear scope" Width="110" Height="28" Click="OnResetIsolation" />
            <Button Content="Highlight" Width="110" Height="28" Margin="8,0,0,0" IsDefault="True" Click="OnHighlight" />
            <Button Content="Close" Width="90" Height="28" Margin="8,0,0,0" Click="OnClose" />
        </StackPanel>

    </Grid>
</Window>
