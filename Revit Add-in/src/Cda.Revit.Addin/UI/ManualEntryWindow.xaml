<Window x:Class="Cda.Revit.Addin.UI.ManualEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Manual Entry"
        SizeToContent="Height"
        Width="460"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">

    <StackPanel Margin="16">

        <TextBlock x:Name="Intro"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Text="Log work that happened away from the model — a client meeting, a call, coordination in a spreadsheet. It is stored in the same log and the same export as tracked time." />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Date" FontWeight="SemiBold" />
                <DatePicker x:Name="DateBox" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Started at (HH:mm)" FontWeight="SemiBold" />
                <TextBox x:Name="StartTimeBox" Margin="0,4,0,0" Padding="4" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Duration" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
            <TextBox x:Name="HoursBox" Width="60" Padding="4" />
            <TextBlock Text="hours" Margin="6,0,16,0" VerticalAlignment="Center" />
            <TextBox x:Name="MinutesBox" Width="60" Padding="4" />
            <TextBlock Text="minutes" Margin="6,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Project code" FontWeight="SemiBold" />
                <TextBox x:Name="ProjectNumberBox" Margin="0,4,0,0" Padding="4" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Project name" FontWeight="SemiBold" />
                <TextBox x:Name="ProjectNameBox" Margin="0,4,0,0" Padding="4" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Task description" FontWeight="SemiBold" />
        <TextBox x:Name="DescriptionBox"
                 Margin="0,4,0,12"
                 Padding="4"
                 Height="60"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" IsDefault="True" Width="90" Height="26" Click="OnSave" />
            <Button Content="Cancel" IsCancel="True" Width="90" Height="26" Margin="8,0,0,0" />
        </StackPanel>

    </StackPanel>
</Window>
