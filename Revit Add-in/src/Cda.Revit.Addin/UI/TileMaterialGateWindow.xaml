<Window x:Class="Cda.Revit.Addin.UI.TileMaterialGateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Painted Surface Area"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        ThemeMode="Light"
        FontFamily="Segoe UI Variable Text">

    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Text="Before this run, confirm whether either room type below needs its tile material checked. If Yes, the room must already carry a material code ending in &quot;F&quot; (e.g. LIF, VBF, GBF) or the run is blocked." />

        <CheckBox x:Name="AlrumKokkenBox"
                  Margin="0,0,0,12"
                  Content="Does your Alrum/Køkken have a Tile Material?" />

        <CheckBox x:Name="BadToiletBox"
                  Margin="0,0,0,4"
                  Content="Does your Bad/Toilet have a Tile Material?" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Continue" IsDefault="True" Width="100" Height="28" Click="OnContinue" />
            <Button Content="Cancel" IsCancel="True" Width="100" Height="28" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
