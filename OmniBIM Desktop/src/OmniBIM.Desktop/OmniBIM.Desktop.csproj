<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OmniBIM.Desktop</RootNamespace>
    <AssemblyName>OmniBIM.Desktop</AssemblyName>
    <ApplicationIcon>Resources\omnibim.ico</ApplicationIcon>
    <!--
      Deliberately zero PackageReferences for this Phase 1 scaffold: the data layer
      (Services/*, Models/*) and the MVVM base (ViewModels/ObservableObject) are hand-rolled
      so the project builds and runs with only the .NET SDK, no NuGet restore required. Add
      CommunityToolkit.Mvvm and a charting library (e.g. LiveCharts2) once the project has a
      network-connected build pipeline and the hand-rolled bar row in Views/TimeManagementView
      needs to grow into a real chart control.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded as a WPF resource so MainWindow.xaml's Icon="Resources/omnibim.ico" resolves
         regardless of where the built exe ends up - not just used for ApplicationIcon above,
         which only sets the exe's own PE icon (taskbar, Explorer, shortcuts). -->
    <Resource Include="Resources\omnibim.ico" />
    <!-- Same reason: MainWindow.xaml's watermark Image needs this embedded to resolve its relative Source path. -->
    <Resource Include="Resources\omnibim-logo.png" />
    <!-- Chroma-keyed transparent version (the source logo's own light backdrop removed) for
         the sidebar icon, which sits on a dark background where the backdrop would show as a box. -->
    <Resource Include="Resources\omnibim-logo-transparent.png" />
  </ItemGroup>

</Project>
