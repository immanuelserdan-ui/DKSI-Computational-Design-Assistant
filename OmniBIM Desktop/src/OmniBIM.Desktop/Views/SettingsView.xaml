<UserControl x:Class="OmniBIM.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="24" MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Foreground="#111827" />

        <Border Background="White" CornerRadius="12" Padding="20" Margin="0,16,0,0" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Shared time-tracking folder" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                <TextBlock Text="Overrides the Revit add-in's own SharedFolder setting on this machine. Needed for the team-wide Project Status and Team Members figures. Requires a restart to take effect."
                           FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,2,0,8" />
                <TextBox Text="{Binding SharedTimeTrackingFolder, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" BorderBrush="#D1D5DB" BorderThickness="1" FontSize="12" />
            </StackPanel>
        </Border>

        <Border Background="White" CornerRadius="12" Padding="20" Margin="0,16,0,0" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Gemini API key" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                <TextBlock FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,2,0,8">
                    Powers the OmniBIM Assistant chat panel on Home. Get a free one at
                    <Run FontFamily="Consolas" Text="aistudio.google.com/apikey" />
                    . The
                    <Run FontFamily="Consolas" Text="GEMINI_API_KEY" />
                    environment variable is checked first; set one here only if you'd rather keep it local to
                    this app. Stored under %LOCALAPPDATA%, never in the git repo. Leave blank to keep the
                    current key.
                </TextBlock>
                <PasswordBox x:Name="ApiKeyBox" Padding="8" BorderBrush="#D1D5DB" BorderThickness="1" FontSize="12"
                             PasswordChanged="ApiKeyBox_PasswordChanged" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#DC2626" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasApiKeyConfigured}" Value="True">
                                        <Setter Property="Fill" Value="#16A34A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="#6B7280">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="No key configured yet" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasApiKeyConfigured}" Value="True">
                                        <Setter Property="Text" Value="A key is configured" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="Model" FontSize="13" FontWeight="SemiBold" Foreground="#111827" Margin="0,16,0,0" />
                <TextBox Text="{Binding GeminiModel, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" BorderBrush="#D1D5DB" BorderThickness="1" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" Padding="16,8"
                    Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" />
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#6B7280"
                       VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
