<UserControl x:Class="OmniBIM.Desktop.Views.TrendNewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:OmniBIM.Desktop.Models">

    <ScrollViewer>
        <StackPanel Margin="24">
            <TextBlock Text="Trend News" FontSize="22" FontWeight="Bold" Foreground="#111827" />
            <TextBlock FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0" TextWrapping="Wrap">
                A hand-picked snapshot of real BIM/AEC industry articles, not a live feed - click a card to open the source in your browser.
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Articles}" Margin="0,16,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:NewsArticle}">
                        <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,16,16"
                                BorderBrush="#E5E7EB" BorderThickness="1" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding Url}" />
                            </Border.InputBindings>
                            <StackPanel>
                                <Border Background="#EEF2FF" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="#4338CA" />
                                </Border>

                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#111827"
                                           TextWrapping="Wrap" Margin="0,10,0,6" />

                                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" />

                                <TextBlock Text="{Binding Source}" FontSize="11" Foreground="#9CA3AF" FontStyle="Italic" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
