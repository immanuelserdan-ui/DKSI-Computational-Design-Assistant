<UserControl x:Class="OmniBIM.Desktop.Views.PlaceholderPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="24">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Foreground="#111827" />

        <Border Background="White" CornerRadius="12" Padding="24" Margin="0,16,0,0" BorderBrush="#E5E7EB" BorderThickness="1">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#6B7280" FontSize="13" />
        </Border>
    </StackPanel>
</UserControl>
