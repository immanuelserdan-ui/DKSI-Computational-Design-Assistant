<UserControl x:Class="OmniBIM.Desktop.Views.TimeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OmniBIM.Desktop.ViewModels"
             xmlns:local="clr-namespace:OmniBIM.Desktop.Views">

    <UserControl.Resources>
        <local:FractionToHeightConverter x:Key="FractionToHeight" />
        <local:TodayToBrushConverter x:Key="TodayToBrush" />
        <local:ImprovementToBrushConverter x:Key="ImprovementToBrush" />
    </UserControl.Resources>

    <Border Background="White" CornerRadius="12" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Time Management" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />

            <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                <TextBlock Text="{Binding TotalThisWeek, StringFormat={}{0:0.0} h}" FontSize="24" FontWeight="Bold" Foreground="#111827" />
                <TextBlock Margin="8,6,0,0" FontSize="12" Text="{Binding WeekTrendLabel}"
                           Foreground="{Binding WeekTrendIsImprovement, Converter={StaticResource ImprovementToBrush}}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DayBarViewModel}">
                        <StackPanel Margin="4,0" VerticalAlignment="Bottom">
                            <Grid Height="120" VerticalAlignment="Bottom">
                                <Border VerticalAlignment="Bottom" Height="{Binding FractionOfCap, Converter={StaticResource FractionToHeight}}"
                                        CornerRadius="4"
                                        Background="{Binding IsToday, Converter={StaticResource TodayToBrush}}" />
                            </Grid>
                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Hours, StringFormat={}{0:0.0}h}" HorizontalAlignment="Center" FontSize="10" Foreground="#9CA3AF" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
