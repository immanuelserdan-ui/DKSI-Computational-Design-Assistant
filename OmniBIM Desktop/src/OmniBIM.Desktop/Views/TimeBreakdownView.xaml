<UserControl x:Class="OmniBIM.Desktop.Views.TimeBreakdownView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OmniBIM.Desktop.ViewModels"
             xmlns:svc="clr-namespace:OmniBIM.Desktop.Services"
             xmlns:local="clr-namespace:OmniBIM.Desktop.Views">

    <UserControl.Resources>
        <local:ShareToWidthConverter x:Key="ShareToWidth" />
    </UserControl.Resources>

    <StackPanel>
        <!-- Time by task phase -->
        <Border Background="White" CornerRadius="12" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Time by Task Phase" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
                <TextBlock Text="This week, billable time only" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,12" />

                <ItemsControl ItemsSource="{Binding TaskPhaseBreakdown}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type svc:TaskPhaseHours}">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding TaskPhase}" FontSize="12" Foreground="#374151"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <Border Grid.Column="1" Height="10" Background="#EEF2FF" CornerRadius="5" VerticalAlignment="Center" Margin="8,0">
                                    <Border HorizontalAlignment="Left" Height="10" CornerRadius="5" Background="#2563EB"
                                            Width="{Binding Share, Converter={StaticResource ShareToWidth}}" />
                                </Border>

                                <TextBlock Grid.Column="2" Text="{Binding Hours, StringFormat={}{0:0.0}h}" FontSize="12"
                                           Foreground="#111827" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No billable time recorded this week yet." FontSize="12" Foreground="#9CA3AF">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TaskPhaseBreakdown.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Time by project -->
        <Border Background="White" CornerRadius="12" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Time by Project" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
                <TextBlock Text="This week" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,12" />

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Project" FontSize="10" Foreground="#9CA3AF" />
                    <TextBlock Grid.Column="1" Text="Today" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="Week" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Right" />
                </Grid>

                <ItemsControl ItemsSource="{Binding ProjectBreakdown}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type svc:ProjectHours}">
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ProjectName}" FontSize="12" Foreground="#111827"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding HoursToday, StringFormat={}{0:0.0}h}" FontSize="12"
                                           Foreground="#374151" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{Binding HoursThisWeek, StringFormat={}{0:0.0}h}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#111827" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No projects recorded this week yet." FontSize="12" Foreground="#9CA3AF" Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProjectBreakdown.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
