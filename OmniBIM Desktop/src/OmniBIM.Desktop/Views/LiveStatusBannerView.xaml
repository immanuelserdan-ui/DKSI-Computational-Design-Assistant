<UserControl x:Class="OmniBIM.Desktop.Views.LiveStatusBannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext is a LiveStatusViewModel directly (see MainWindow.xaml usages) - reads
         Revit's live status pipe every second, independent of the CSV-driven widgets. -->
    <Border Background="White" CornerRadius="10" Padding="12,10" BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="#D1D5DB" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Fill" Value="#16A34A" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLive}" Value="True" />
                                    <Condition Binding="{Binding IsIdle}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Fill" Value="#D97706" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#9CA3AF" />
                        <Setter Property="Text" Value="No live Revit session - showing last known data only." />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Foreground" Value="#111827" />
                                <Setter Property="Text">
                                    <Setter.Value>
                                        <MultiBinding StringFormat="Live now: {0} — {1} · {2}">
                                            <Binding Path="ProjectName" />
                                            <Binding Path="ViewName" />
                                            <Binding Path="ElapsedLabel" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
