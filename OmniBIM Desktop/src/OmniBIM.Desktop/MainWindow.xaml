<Window x:Class="OmniBIM.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OmniBIM.Desktop.Views"
        xmlns:local="clr-namespace:OmniBIM.Desktop.Views"
        Title="OmniBIM by DKSI" Height="800" Width="1280" MinWidth="960"
        Icon="Resources/omnibim.ico"
        Background="#F3F4F6">

    <Window.Resources>
        <local:AppPageToVisibilityConverter x:Key="PageToVisibility" />
        <local:SelectedNavToBackgroundConverter x:Key="NavToBackground" />
        <local:SelectedNavToForegroundConverter x:Key="NavToForeground" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="12,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{Binding IsSelected, Converter={StaticResource NavToBackground}}" />
            <Setter Property="Foreground" Value="{Binding IsSelected, Converter={StaticResource NavToForeground}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0F172A">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,24">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Resources/omnibim-logo-transparent.png" Width="26" Height="26" />
                        <TextBlock Text="OmniBIM" FontSize="18" FontWeight="Bold" Foreground="White"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="by DKSI" FontSize="11" Foreground="#60A5FA" Margin="34,2,0,0" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Command="{Binding SelectCommand}" Style="{StaticResource NavButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <!-- Brand watermark: behind every page (first child = bottom of z-order in a Grid),
                 low opacity, anchored bottom-left where the page content actually leaves empty
                 space (below the cards in the left column) rather than the overall bottom-right
                 corner, which the tall chat panel already covers on Home. -->
            <Image Source="Resources/omnibim-logo.png" Opacity="0.10" Stretch="Uniform"
                   Width="420" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="40,0,0,40" IsHitTestVisible="False" />

            <ScrollViewer Visibility="{Binding CurrentPage, Converter={StaticResource PageToVisibility}, ConverterParameter=Home}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Home" FontSize="22" FontWeight="Bold" Foreground="#111827" />

                    <!-- Live status: read directly from Revit's live status pipe, independent of the CSV-driven widgets below. -->
                    <views:LiveStatusBannerView Grid.Row="1" Grid.Column="0" DataContext="{Binding LiveStatus}" Margin="0,16,16,0" />

                    <UniformGrid Grid.Row="2" Grid.Column="0" Columns="4" Margin="0,16,16,0">
                        <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,12,0" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Active Projects" FontSize="11" Foreground="#6B7280" />
                                <TextBlock Text="{Binding Dashboard.ProjectStatus.ActiveCount}" FontSize="26" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,12,0" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="On-going" FontSize="11" Foreground="#6B7280" />
                                <TextBlock Text="{Binding Dashboard.ProjectStatus.OnGoingCount}" FontSize="26" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,12,0" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Team Members" FontSize="11" Foreground="#6B7280" />
                                <TextBlock Text="{Binding Dashboard.TimeManagement.TeamMemberCount}" FontSize="26" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,0" />
                                <TextBlock Text="active this week" FontSize="10" Foreground="#9CA3AF" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="12" Padding="16" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="This Week's Hours" FontSize="11" Foreground="#6B7280" />
                                <TextBlock Text="{Binding Dashboard.TimeManagement.TotalThisWeek, StringFormat={}{0:0.0}h}" FontSize="26" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <views:ProjectStatusView Grid.Row="3" Grid.Column="0" DataContext="{Binding Dashboard.ProjectStatus}" Margin="0,16,16,0" VerticalAlignment="Top" />

                    <StackPanel Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Margin="0,16,0,0">
                        <views:TimeManagementView DataContext="{Binding Dashboard.TimeManagement}" />
                        <views:ChatPanelView DataContext="{Binding Chat}" Margin="0,16,0,0" Height="420" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <ScrollViewer Visibility="{Binding CurrentPage, Converter={StaticResource PageToVisibility}, ConverterParameter=TimeManagement}">
                <StackPanel Margin="24">
                    <TextBlock Text="Time Management" FontSize="22" FontWeight="Bold" Foreground="#111827" />
                    <views:LiveStatusBannerView DataContext="{Binding LiveStatus}" Margin="0,16,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                    <views:TimeManagementView DataContext="{Binding Dashboard.TimeManagement}" Margin="0,16,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                    <views:TimeBreakdownView DataContext="{Binding Dashboard.TimeManagement}" Margin="0,16,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Visibility="{Binding CurrentPage, Converter={StaticResource PageToVisibility}, ConverterParameter=ProjectStatus}">
                <StackPanel Margin="24">
                    <TextBlock Text="Project Status" FontSize="22" FontWeight="Bold" Foreground="#111827" />
                    <views:ProjectStatusView DataContext="{Binding Dashboard.ProjectStatus}" Margin="0,16,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>

            <views:PlaceholderPageView DataContext="{Binding Projects}"
                                        Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToVisibility}, ConverterParameter=Projects}" />
            <views:PlaceholderPageView DataContext="{Binding ScanToBim}"
                                        Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToVisibility}, ConverterParameter=ScanToBim}" />
            <views:PlaceholderPageView DataContext="{Binding Workflow}"
                                        Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToVisibility}, ConverterParameter=Workflow}" />
            <views:TrendNewsView DataContext="{Binding TrendNews}"
                                 Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToVisibility}, ConverterParameter=TrendNews}" />
            <views:PlaceholderPageView DataContext="{Binding Teams}"
                                        Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToVisibility}, ConverterParameter=Teams}" />
            <views:PlaceholderPageView DataContext="{Binding Reports}"
                                        Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToVisibility}, ConverterParameter=Reports}" />
            <views:SettingsView DataContext="{Binding Settings}"
                                 Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToVisibility}, ConverterParameter=Settings}" />
        </Grid>
    </Grid>
</Window>
