<Window x:Class="OmniBIM.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OmniBIM.Desktop.Views"
        xmlns:local="clr-namespace:OmniBIM.Desktop.Views"
        Title="OmniBIM by DKSI" Height="760" Width="1100"
        Background="#F3F4F6">

    <Window.Resources>
        <local:AppPageToVisibilityConverter x:Key="PageToVisibility" />
        <local:SelectedNavToBackgroundConverter x:Key="NavToBackground" />
        <local:SelectedNavToForegroundConverter x:Key="NavToForeground" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="12,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{Binding IsSelected, Converter={StaticResource NavToBackground}}" />
            <Setter Property="Foreground" Value="{Binding IsSelected, Converter={StaticResource NavToForeground}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0F172A">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,24">
                    <TextBlock Text="OmniBIM" FontSize="18" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="by DKSI" FontSize="11" Foreground="#60A5FA" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Command="{Binding SelectCommand}" Style="{StaticResource NavButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <ScrollViewer Visibility="{Binding CurrentPage, Converter={StaticResource PageToVisibility}, ConverterParameter=Home}">
                <StackPanel Margin="24">
                    <TextBlock Text="Home" FontSize="22" FontWeight="Bold" Foreground="#111827" />
                    <views:TimeManagementView DataContext="{Binding Dashboard.TimeManagement}" Margin="0,16,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                    <views:ProjectStatusView DataContext="{Binding Dashboard.ProjectStatus}" Margin="0,16,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Visibility="{Binding CurrentPage, Converter={StaticResource PageToVisibility}, ConverterParameter=TimeManagement}">
                <StackPanel Margin="24">
                    <TextBlock Text="Time Management" FontSize="22" FontWeight="Bold" Foreground="#111827" />
                    <views:TimeManagementView DataContext="{Binding Dashboard.TimeManagement}" Margin="0,16,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                    <views:TimeBreakdownView DataContext="{Binding Dashboard.TimeManagement}" Margin="0,16,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Visibility="{Binding CurrentPage, Converter={StaticResource PageToVisibility}, ConverterParameter=ProjectStatus}">
                <StackPanel Margin="24">
                    <TextBlock Text="Project Status" FontSize="22" FontWeight="Bold" Foreground="#111827" />
                    <views:ProjectStatusView DataContext="{Binding Dashboard.ProjectStatus}" Margin="0,16,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>

            <views:PlaceholderPageView DataContext="{Binding Projects}"
                                        Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToVisibility}, ConverterParameter=Projects}" />
            <views:PlaceholderPageView DataContext="{Binding ScanToBim}"
                                        Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToVisibility}, ConverterParameter=ScanToBim}" />
            <views:PlaceholderPageView DataContext="{Binding Workflow}"
                                        Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToVisibility}, ConverterParameter=Workflow}" />
            <views:PlaceholderPageView DataContext="{Binding TrendNews}"
                                        Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToVisibility}, ConverterParameter=TrendNews}" />
            <views:PlaceholderPageView DataContext="{Binding Teams}"
                                        Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToVisibility}, ConverterParameter=Teams}" />
            <views:PlaceholderPageView DataContext="{Binding Reports}"
                                        Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToVisibility}, ConverterParameter=Reports}" />
            <views:PlaceholderPageView DataContext="{Binding Settings}"
                                        Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToVisibility}, ConverterParameter=Settings}" />
        </Grid>
    </Grid>
</Window>
