# =============================================================================
#  Line-ending policy
#
#  Without this, git normalises line endings on checkout and every .cs file in
#  the tree gets rewritten LF -> CRLF the first time git touches it. That is not
#  cosmetic here: a multi-line string literal in a dialog contains those line
#  endings, so the compiled assembly changes, and a build that should have been
#  byte-identical produces a different DLL. It cost a confusing round of "did the
#  source change or didn't it?" the day version control was introduced.
#
#  Pinning text files to LF in the repository and letting git hand out native
#  endings in the working tree keeps builds reproducible and diffs honest.
# =============================================================================

* text=auto eol=lf

# Windows-only launchers. These MUST keep CRLF: cmd.exe mis-parses a .cmd file
# with LF endings, and the installer is the one file a colleague runs first.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary - never normalise, never diff as text.
*.png  binary
*.ico  binary
*.jpg  binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.rvt  binary
*.rte  binary
*.rfa  binary
*.msi  binary
*.zip  binary
